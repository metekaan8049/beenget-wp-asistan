# Bu degerleri Vercel > Project > Settings > Environment Variables bolumune girin.
# Bu dosyaya gercek anahtar yazip GitHub'a GONDERMEYIN.

# --- WhatsApp Cloud API (developers.facebook.com > uygulamaniz > WhatsApp) ---
WHATSAPP_TOKEN=                 # Kalici (System User) erisim anahtari
WHATSAPP_PHONE_NUMBER_ID=       # Telefon numarasi kimligi (Phone number ID)
WHATSAPP_VERIFY_TOKEN=          # Kendiniz uydurun, Meta webhook ayarina da ayni degeri yazin
WHATSAPP_APP_SECRET=            # Uygulama > Ayarlar > Temel > Uygulama gizli anahtari
GRAPH_API_VERSION=v23.0

# --- Yapay zeka (UCRETSIZ varsayilan: Vercel AI Gateway, anahtar gerekmez) ---
# Vercel'de hicbir sey girmeseniz de AI Gateway kullanilir (ayda 5$ ucretsiz kredi).
AI_MODEL=google/gemini-3.8-flash   # AI Gateway'deki herhangi bir model kimligi
# Alternatif ucretsiz: Google AI Studio anahtari (aistudio.google.com > Get API key)
# GEMINI_API_KEY=
# Ucretli alternatif: Claude
# ANTHROPIC_API_KEY=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # "service_role" anahtari (gizli tutun)

# --- Resend (bildirim e-postalari, istege bagli) ---
RESEND_API_KEY=
NOTIFY_FROM=Beenget Asistan <asistan@beengetbookings.com>
NOTIFY_TO=metekaancetin@beengetbookings.com

# --- Isletme sahibi ---
OWNER_WA_ID=90XXXXXXXXXX        # Sizin KISISEL numaraniz (isletme numarasindan farkli), + olmadan
HUMAN_TIMEOUT_HOURS=12
HISTORY_LIMIT=20
